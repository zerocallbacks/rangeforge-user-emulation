# Set default behavior to automatically normalize line endings
* text=auto

# Explicit text files with LF (Unix style)
*.go text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
Makefile text eol=lf
LICENSE text eol=lf

# Explicit text files with CRLF (Windows PowerShell / Batch)
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.b64 text
